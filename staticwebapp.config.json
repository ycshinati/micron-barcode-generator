{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/js/*", "/tests/*", "*.{css,js,json,txt,mjs,map}"]
  },
  "routes": [
    {
      "route": "/tests/*",
      "statusCode": 404
    },
    {
      "route": "/package.json",
      "statusCode": 404
    },
    {
      "route": "/.gitignore",
      "statusCode": 404
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
